<?xml version="1.0" encoding="utf-8"?>
<!-- No plain http anywhere, and only the system's certificate authorities: a certificate a user
     or an app installed is never trusted (SECURITY.md threat 99). tailscale serve uses a
     Let's Encrypt certificate, which the system trusts. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
