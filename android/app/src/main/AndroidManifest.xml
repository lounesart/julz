<?xml version="1.0" encoding="utf-8"?>
<!-- Each permission is here for the code that needs it, and check-apk.py compares the built APK
     with this list (SECURITY.md threats 97, 99). No backups of any kind (threat 88). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The stream to my own push server over Tailscale (86, 92) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Staying alive on HyperOS: a foreground service of type specialUse (92) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Counts only notifications (90); Android asks me once -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Listening again after a reboot (92) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:allowAudioPlaybackCapture="false"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="Julz"
        android:supportsRtl="true"
        android:theme="@style/Theme.Julz">

        <!-- Not exported: the app's own intents reach it, notification taps among them (99, 135) -->
        <!-- Compose redraws for a rotation itself (SizeClass, the rail): recreating the activity
             threw me out of a chat to Feed (found 18 Oct, native chat). The keyboard resizes the
             window and Compose pads for it (imePadding); panning on top of that pushed the chat's
             header off the screen and left a gap above the keyboard (found 19 Oct) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop" />

        <!-- The only exported components: the launcher, one alias of MainActivity per accent, one
             enabled at a time by LauncherIcon, Magenta by default (threats 99, 135) -->
        <activity-alias
            android:name=".IconMagenta"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconRedStone"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_redstone"
            android:roundIcon="@mipmap/ic_launcher_redstone"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconAcid"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_acid"
            android:roundIcon="@mipmap/ic_launcher_acid"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconCyan"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cyan"
            android:roundIcon="@mipmap/ic_launcher_cyan"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconSand"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sand"
            android:roundIcon="@mipmap/ic_launcher_sand"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconLavender"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_lavender"
            android:roundIcon="@mipmap/ic_launcher_lavender"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconOrange"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_orange"
            android:roundIcon="@mipmap/ic_launcher_orange"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".JulzService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="One connection to my own push server for Julz notices" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Added by androidx.profileinstaller, exported behind DUMP. Removed: nothing but the
             launcher is exported (threat 99); the cost is a slower first start -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />
    </application>
</manifest>
