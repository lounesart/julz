# Fallback for julz-keep-sync.path: a sync that failed (Open WebUI not running) is tried again
# here, and a kept note deleted by hand is noticed (13). With no stamp and Claude/ unchanged
# the service exits at once and never reads the key (154).
[Unit]
Description=julz: retry the sync of kept notes every 10 minutes

[Timer]
OnCalendar=*:5/10
Unit=julz-keep-sync.service

[Install]
WantedBy=timers.target
