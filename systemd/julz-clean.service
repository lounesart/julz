# Removes delegation leftovers (julz-clean.py). SECURITY.md threats 44 to 46.
# Started only by julz-clean.timer or by hand: nothing julz can reach starts it.
[Unit]
Description=julz: remove delegation leftovers

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I %h/.local/lib/julz/current/julz-clean.py
UMask=0077
TimeoutStartSec=10min
Nice=10
# Sandbox: an empty read only home, only the folders it cleans bound back. The token, keys,
# ~/.ssh and my real projects are not even visible, whatever a planted link points at
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateNetwork=yes
TemporaryFileSystem=%h:ro
BindReadOnlyPaths=%h/.local/lib/julz
BindPaths=%h/.local/share/julz/work %h/.local/share/julz/approved
BindPaths=%h/.local/share/julz/done %h/.local/share/julz/quarantine
BindPaths=%h/.local/share/julz/tasks %h/.local/share/julz/log
BindPaths=%h/.local/share/julz/control
# Stale Keep markers and manifests of deleted work copies (threats 57, 59)
BindPaths=%h/.local/share/julz/keep %h/.local/share/julz/manifests
# The gate lock, so a rotation never races the runner (threat 53). flock works through a bind
BindPaths=%h/.local/share/julz/run.lock
BindPaths=%h/Documents/julz-mem/Inbox/claude %h/Documents/julz-mem/Outbox
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
LockPersonality=yes
