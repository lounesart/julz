# "N new notes" to the Feed (julz-notify.py --notes, threat 142), counts only, at most once a
# minute. Started by julz-notify-notes.path.
[Unit]
Description=julz: tell the phone about new notes

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I %h/.local/lib/julz/current/julz-notify.py --notes
UMask=0077
# Sandbox as julz-notify-todos: only the snapshot julz-vault wrote, the topic and the notify
# token; no note and nothing else of the vault is visible
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
TemporaryFileSystem=%h:ro
BindReadOnlyPaths=%h/.local/lib/julz
BindReadOnlyPaths=%h/.config/julz/notify
BindReadOnlyPaths=%h/.local/share/julz/vault
BindPaths=%h/.local/share/julz/notify
# Unix sockets only: posts go to julz-ntfy's socket (132)
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
LockPersonality=yes
