[Unit]
Description=julz: notify about approvals and run results

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I %h/Projects/products/julz/julz-notify.py --log
UMask=0077
# Sandbox: reads runner.log, the topic and its own state, talks to ntfy.sh
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
TemporaryFileSystem=%h:ro
BindReadOnlyPaths=%h/Projects/products/julz
BindReadOnlyPaths=%h/.config/julz/notify %h/.config/julz/approver.json
BindReadOnlyPaths=%h/.local/share/julz/runner.log
BindPaths=%h/.local/share/julz/notify
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
LockPersonality=yes
