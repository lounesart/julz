[Unit]
Description=julz: notify about approvals and run results

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I %h/.local/lib/julz/current/julz-notify.py --log
UMask=0077
# Sandbox: reads runner.log, the topic and its own state, posts to my own ntfy
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
TemporaryFileSystem=%h:ro
BindReadOnlyPaths=%h/.local/lib/julz
BindReadOnlyPaths=%h/.config/julz/notify
BindReadOnlyPaths=%h/.local/share/julz/log
BindPaths=%h/.local/share/julz/notify
# Unix sockets only: posts go to julz-ntfy's socket, seccomp refuses any internet socket (132)
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
LockPersonality=yes
