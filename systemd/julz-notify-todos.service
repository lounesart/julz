# "N open todos" to my own push server only, never ntfy.sh (julz-notify.py --todos, threat 100).
# Started by julz-notify-todos.path. Posts only when the snapshot changed.
[Unit]
Description=julz: post open tasks to the phone app

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I %h/.local/lib/julz/current/julz-notify.py --todos
UMask=0077
# Sandbox: reads only the snapshot julz-vault wrote (julz-vault has no network), the topic and
# the notify token; no note and nothing else of the vault is visible. load_local refuses any
# server but 127.0.0.1:8090 (IPAddressDeny is ignored in user units, so the check is in code)
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
TemporaryFileSystem=%h:ro
BindReadOnlyPaths=%h/.local/lib/julz
BindReadOnlyPaths=%h/.config/julz/notify
BindReadOnlyPaths=%h/.local/share/julz/vault
BindPaths=%h/.local/share/julz/notify
# Unix sockets only: posts go to julz-ntfy's socket, seccomp refuses any internet socket (132)
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
LockPersonality=yes
