[Unit]
Description=julz: notify about specs waiting for approval

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I %h/.local/lib/julz/current/julz-notify.py --inbox
UMask=0077
# Sandbox: reads file names in the inbox, the topic and its own state, posts to my own ntfy
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
TemporaryFileSystem=%h:ro
BindReadOnlyPaths=%h/.local/lib/julz
BindReadOnlyPaths=%h/.config/julz/notify
BindReadOnlyPaths=%h/Documents/julz-mem/Inbox/claude
BindPaths=%h/.local/share/julz/notify
# Unix sockets only: posts go to julz-ntfy's socket, seccomp refuses any internet socket (132)
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
LockPersonality=yes
